{
  "name": "altaka-alwataniyah-field",
  "productName": "ALTAKA-ALWATANIYAH Field",
  "version": "1.0.0",
  "description": "تطبيق الموظف الميداني – الطاقة الوطنية (ويندوز وماك)",
  "main": "main.js",
  "author": "ALTAKA-ALWATANIYAH",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.altakaalwataniyah.field",
    "productName": "ALTAKA-ALWATANIYAH Field",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "الموظف الميداني",
      "artifactName": "altaka-alwataniyah-field-setup.${ext}"
    },
    "portable": {
      "artifactName": "altaka-alwataniyah-field-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "altaka-alwataniyah-field-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "لالتقاط صورة السيلفي ومسح الباركود وتصوير المعوقات",
        "NSMicrophoneUsageDescription": "لتسجيل صوت فيديو المعوقات",
        "NSLocationUsageDescription": "لتوثيق موقع الحضور والانصراف",
        "NSLocationWhenInUseUsageDescription": "لتوثيق موقع الحضور والانصراف"
      }
    },
    "dmg": {
      "title": "الموظف الميداني"
    }
  }
}